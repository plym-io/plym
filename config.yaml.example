name: Plym
# One line about the blog. Used as the index page's meta description.
description:
website: plym.local
blog_home: plym.local
blog_prefix: /
language: en
template: default

# Leave this out and the template decides. A slot is either a Google Fonts family
# name or a family plus the weights to download; the role names are labels for
# --wght-<slot>-<role>, and only light, regular, medium, bold and black exist.
# fonts:
#   heading:
#     family: Inter
#     weights:
#       bold: 600
#       black: 900
#   body:
#     family: Merriweather
#     weights:
#       regular: 400

prism:
  enabled: true
  languages: python

logo: https://plym.io/assets/logo.svg
favicon: https://plym.io/assets/favicon.ico

robots:
  serve: true

# Serve the markdown twin at an explicit .md URL (/hello.md). Accept: text/markdown
# negotiation on the canonical URL is always on, whatever this is set to.
md_urls:
  enabled: false

inject:
  head: ""
  body: ""

# Header and footer navigation, written as 'Name: url' and read in templates as
# links.header and links.footer. A name may carry its own block instead of a url; that
# block renders as a dropdown in the header and as a titled column in the footer, and
# nests one level deep. Grouping is per link: footer links left ungrouped render as one
# row beneath the columns. Links appear in the order they are written, and a nested block
# may also be spelled as a list of '- Name: url' pairs.
# links:
#   header:
#     Home: /
#     Resources:
#       Docs: https://plym.io/docs/
#       Templates: https://plym.io/templates
#   footer:
#     Open Source:
#       GitHub: https://github.com/plym-io/plym
#       License: https://github.com/plym-io/plym/blob/main/LICENSE
#     About: /about

pagination:
  page_size: 10

reading:
  words_per_minute: 200

backup:
  frequency: 7

media:
  location:
