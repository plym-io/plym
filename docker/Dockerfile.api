FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv export --frozen --no-dev --no-emit-project --format requirements-txt > /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt

COPY plym ./plym
RUN uv pip install --system --no-cache --no-deps .

RUN mkdir -p /app/admin

COPY docker-compose.yml .env.example config.yaml.example /opt/plym/dist/
COPY docker/Caddyfile /opt/plym/dist/docker/Caddyfile
COPY bin/plym bin/plym-lib.sh /opt/plym/dist/bin/
COPY docs/HELLO.md /opt/plym/dist/docs/HELLO.md

COPY docker/entrypoint.sh /usr/local/bin/plym-entrypoint
RUN useradd --system --uid 10001 --create-home plym \
    && mkdir -p /app/storage \
    && chown -R plym:plym /app \
    && chmod +x /usr/local/bin/plym-entrypoint

EXPOSE 8000

ENTRYPOINT ["plym-entrypoint"]
CMD ["uvicorn", "plym.main:app", "--host", "0.0.0.0", "--port", "8000"]
